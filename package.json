{
  "name": "dmegle",
  "version": "1.0.0",
  "description": "dMegle - Decentralized real-time video streaming platform on Arkiv blockchain",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/omegle-stream-server.js",
    "start:server": "node dist/server.js",
    "start:index": "node dist/index.js",
    "server": "tsx watch src/server.ts",
    "omegle": "tsx watch src/omegle-server.ts",
    "stream": "tsx watch src/omegle-stream-server.ts",
    "stream-demo": "tsx src/stream.ts",
    "postinstall": "npm run build"
  },
  "keywords": [
    "arkiv",
    "video-streaming",
    "real-time",
    "subscriptions",
    "ethereum",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arkiv-network/sdk": "0.4.4",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "multer": "^1.4.5-lts.1",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/multer": "^1.4.11",
    "@types/fluent-ffmpeg": "^2.1.24",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "tslib": "^2.8.1"
  }
}

